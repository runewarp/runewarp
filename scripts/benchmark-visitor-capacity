#!/usr/bin/env python3
"""Run real release-mode role runtimes. Requires Python psutil; no production-only bypasses.

python3 -m venv target/visitor-capacity-venv
 target/visitor-capacity-venv/bin/pip install psutil
 target/visitor-capacity-venv/bin/python scripts/benchmark-visitor-capacity --output target/capacity-baseline
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import resource
import shutil
import socket
import subprocess
import threading
import time
import sys
import psutil
sys.dont_write_bytecode = True
from lib.visitor_capacity_metadata import portable_invocation, rust_source_sha256, verify_binary_provenance

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', type=Path, required=True)
parser.add_argument('--cooldown-seconds', type=float, default=32)
parser.add_argument('--scenarios', nargs='+', choices=['subcapacity', 'hold-one', 'burst', 'hold-two', 'throughput', 'slow-reader'], default=['subcapacity', 'hold-one', 'burst', 'hold-two', 'throughput', 'slow-reader'])
args = parser.parse_args()
args.output.mkdir(parents=True, exist_ok=False)
print('Build\nBuilding release benchmark roles', flush=True)
loopback = socket.getaddrinfo("localhost", 0, type=socket.SOCK_DGRAM)[0][4][0]
tunnel_bind = f"[{loopback}]:0" if ":" in loopback else f"{loopback}:0"
source_key = rust_source_sha256(Path.cwd())
build_env = dict(os.environ, RUNEWARP_BENCH_SOURCE_SHA256=source_key)
build = subprocess.run(['cargo', 'test', '--release', '--lib', '--no-run', '--message-format=json'], env=build_env, capture_output=True, text=True)
(args.output / 'build.log').write_text(build.stderr)
build.check_returncode()
artifacts = [json.loads(line) for line in build.stdout.splitlines() if line.startswith('{')]
binary = next(a['executable'] for a in artifacts if a.get('executable') and a.get('profile', {}).get('test') and a['target']['name'] == 'runewarp')
if rust_source_sha256(Path.cwd()) != source_key:
    raise RuntimeError('Rust sources changed during benchmark build')
# Freeze the verified bytes so another build cannot replace role executables mid-capture.
frozen_binary = args.output.resolve() / 'benchmark-role'
shutil.copy2(binary, frozen_binary)
binary = str(frozen_binary)
print('Verify\nChecking the compiled Rust source fingerprint', flush=True)
proof = subprocess.run([binary, '--ignored', '--exact', 'capacity_benchmark::visitor_capacity_role', '--nocapture'],
                       env=dict(os.environ, RUNEWARP_BENCH_ROLE='provenance', RUNEWARP_BENCH_DIR=str(args.output.resolve()), RUNEWARP_BENCH_TUNNEL_BIND=tunnel_bind),
                       capture_output=True, text=True)
(args.output / 'provenance.log').write_text(proof.stdout + proof.stderr)
if proof.returncode:
    raise RuntimeError('benchmark provenance unavailable; see provenance.log and rebuild with a separate CARGO_TARGET_DIR')
verify_binary_provenance(args.output, source_key)

environment = {'platform': platform.platform(), 'machine': platform.machine(), 'cpu_count': os.cpu_count(),
               'memory_bytes': psutil.virtual_memory().total, 'nofile': resource.getrlimit(resource.RLIMIT_NOFILE),
               'psutil': psutil.__version__, 'sampling_interval_seconds': 0.25,
               'rust_source_sha256': source_key,
               'rustc': subprocess.check_output(['rustc', '-Vv'], text=True),
               'git_head': os.environ.get('RUNEWARP_BENCH_SOURCE_HEAD') or subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
               'tracked_source_dirty': bool(subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=no'], text=True)),
               'product_diff_sha256': hashlib.sha256(subprocess.check_output(['git', 'diff', 'HEAD', '--', 'src', 'Cargo.toml', 'Cargo.lock'])).hexdigest(),
               **portable_invocation(os.sys.argv, binary)}
(args.output / 'environment.json').write_text(json.dumps(environment, indent=2))


def scenario(name, count, batch, connections, slow=False, transfer=False):
    directory = (args.output / name).resolve()
    directory.mkdir()
    children = []
    samples = {}
    done = threading.Event()

    def launch(role, id='0', **extra):
        label = f'{role}-{id}'
        log = open(directory / f'{label}.log', 'w')
        env = dict(os.environ, RUNEWARP_BENCH_DIR=str(directory), RUNEWARP_BENCH_ROLE=role, RUNEWARP_BENCH_ID=id, RUNEWARP_BENCH_TUNNEL_BIND=tunnel_bind, **extra)
        child = subprocess.Popen([binary, '--ignored', '--exact', 'capacity_benchmark::visitor_capacity_role', '--nocapture'], env=env, stdout=log, stderr=subprocess.STDOUT)
        samples[label] = {'pid': child.pid, 'peak_rss_bytes_sampled': 0, 'peak_open_fds_sampled': 0, 'cpu_seconds_sampled': 0, 'samples': 0, 'sampling_errors': 0, 'history': []}
        children.append((label, child, log))
        return child

    def wait_json(file, predicate=lambda value: True, seconds=30):
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            if file.exists():
                value = json.loads(file.read_text())
                if predicate(value):
                    return value
            if any(c.poll() not in (None, 0) for _, c, _ in children):
                raise RuntimeError(f'role process failed in {directory}')
            time.sleep(0.1)
        raise TimeoutError(str(file))

    def sample():
        while not done.is_set():
            for label, child, _ in list(children):
                if child.poll() is not None:
                    continue
                value = samples[label]
                try:
                    process = psutil.Process(child.pid)
                    value['peak_rss_bytes_sampled'] = max(value['peak_rss_bytes_sampled'], process.memory_info().rss)
                    value['peak_open_fds_sampled'] = max(value['peak_open_fds_sampled'], process.num_fds())
                    cpu = process.cpu_times()
                    value['cpu_seconds_sampled'] = cpu.user + cpu.system
                    value['samples'] += 1
                    value['history'].append({'monotonic_seconds': time.monotonic(), 'rss_bytes': process.memory_info().rss, 'open_fds': process.num_fds(), 'cpu_seconds': value['cpu_seconds_sampled']})
                except (psutil.Error, OSError):
                    value['sampling_errors'] += 1
            done.wait(0.25)

    sampler = threading.Thread(target=sample)
    sampler.start()
    error = None
    try:
        launch('setup').wait(timeout=30)
        backend = launch('backend')
        backend_address = wait_json(directory / 'backend.ready')['address']
        servers = []
        for i in range(connections):
            launch('server', str(i))
            servers.append(wait_json(directory / f'server-{i}.ready'))
        addresses = ', '.join(json.dumps('localhost:' + s['tunnel'].split(':')[-1]) for s in servers)
        (directory / 'client.toml').write_text(f'''[client]
server-addresses = [{addresses}]
server-trust = "ca-file"
server-ca-file = "cert/server-ca.crt"
identity-dir = "identity"
[[client.services]]
backend-address = "{backend_address}"
''')
        launch('client')
        wait_json(directory / 'client.counts.json', lambda value: value['established_tunnel_connections'] == connections)
        # Session completion is observed directly. Allow the independent idle-credit task to fill.
        time.sleep(0.25)
        load = launch('load', RUNEWARP_BENCH_COUNT=str(count), RUNEWARP_BENCH_BATCH=str(batch),
                      RUNEWARP_BENCH_TARGETS=','.join(s['public'] for s in servers), RUNEWARP_BENCH_SLOW=str(int(slow)), RUNEWARP_BENCH_TRANSFER=str(int(transfer)))
        load.wait(timeout=90)
        if load.returncode:
            raise RuntimeError('Visitor load process failed')
        wait_json(directory / 'load.result.json')
    except BaseException as failure:
        error = repr(failure)
        raise
    finally:
        (directory / 'stop').touch()
        deadline = time.monotonic() + 10
        for label, child, log in children:
            try:
                child.wait(timeout=max(0.01, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                samples[label]['forced_cleanup'] = True
                child.terminate()
                try:
                    child.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait(timeout=2)
            samples[label]['returncode'] = child.returncode
            if samples[label]['samples'] == 0:
                for key in ['peak_rss_bytes_sampled', 'peak_open_fds_sampled', 'cpu_seconds_sampled']:
                    samples[label][key] = None
            log.close()
        done.set()
        sampler.join(timeout=5)
        (directory / 'process-metrics.json').write_text(json.dumps({'processes': samples, 'error': error}, indent=2))
    result = json.loads((directory / 'load.result.json').read_text())
    result['role_counts'] = {p.name: json.loads(p.read_text()) for p in directory.glob('*.counts.json')}
    (directory / 'summary.json').write_text(json.dumps(result, indent=2))
    print(f'Results: {name}', flush=True)
    print(f"Established: {result['established_and_byte_validated']}/{result['attempted']}; working after hold: {result['still_working_after_hold']}", flush=True)
    print(f"TTFB p50/p99 ms: {result['ttfb_p50_ms']}/{result['ttfb_p99_ms']}; failures: {sum(result['failures'].values())}", flush=True)
    print(f"Artifacts: {name}/summary.json and {name}/process-metrics.json", flush=True)

scenarios = {'subcapacity': (256, 32, 1), 'hold-one': (10000, 32, 1), 'burst': (2000, 2000, 1),
             'hold-two': (10000, 32, 2), 'throughput': (256, 32, 1, False, True), 'slow-reader': (128, 32, 1, True)}
for name in args.scenarios:
    print(f'\nScenario: {name}\nCooldown {args.cooldown_seconds}s before fresh role processes', flush=True)
    time.sleep(args.cooldown_seconds)
    scenario(name, *scenarios[name])
